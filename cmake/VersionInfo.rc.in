// Version resource of an appbox executable.
//
// This file is generated by CMake at configure time from
// cmake/VersionInfo.rc.in and is not part of the source tree. The top level
// CMakeLists.txt and launcher/CMakeLists.txt each configure this template once,
// with the file description and the names of their own product; the version
// numbers come from the project version of the top level CMakeLists.txt, so the
// About dialog of the packer and this resource always report the same version.
//
// The template writes no CompanyName and no LegalCopyright entry: the
// repository names no legal entity to put there.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APPBOX_FILE_VERSION_QUAD@
 PRODUCTVERSION @APPBOX_FILE_VERSION_QUAD@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@APPBOX_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@APPBOX_PROJECT_VERSION@"
            VALUE "InternalName", "@APPBOX_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@APPBOX_ORIGINAL_FILENAME@"
            VALUE "ProductName", "appbox"
            VALUE "ProductVersion", "@APPBOX_PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
