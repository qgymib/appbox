// Application resources of the packer.
//
// wxUSE_RC_MANIFEST has to be defined explicitly for MSVC: wx/msw/wx.rc only
// embeds the application manifest when it is set, and wx/msw/rcdefs.h defines
// it for windres only. Without the manifest the process stays DPI unaware and
// Windows bitmap scales the whole user interface.
#define wxUSE_RC_MANIFEST 1

// 2 selects the per monitor v2 manifest (wx/msw/wx_dpi_aware_pmv2.manifest).
#define wxUSE_DPI_AWARE_MANIFEST 2
#include <wx/msw/wx.rc>

// The icon is shared by every executable of the repository and lives in the
// docs directory. The resource compiler resolves this relative path through its
// search path, which contains the directory of this file (CMake passes the
// include directories of the target to the resource compiler).
//
// IDI_ICON1 is a named resource and sorts before the wxICON_AAA icon embedded
// by wx/msw/wx.rc, so Windows picks this icon group for the executable and for
// the default frame icon.
IDI_ICON1 ICON DISCARDABLE "../docs/icon.ico"

// The payloads a pack run needs: the launcher program and the two sandbox
// injection modules, declared as RCDATA resources of this executable. The
// identifiers are shared with the code which reads the payloads back, and the
// statements themselves live in a file which CMake generates at configure time,
// because the payloads are build products of this build tree and are named with
// an absolute path (see the `Payloads embedded as Windows resources` section of
// the top level CMakeLists.txt).
#include "core/EmbeddedResourceIds.h"
#include "EmbeddedResources.generated.rc"
